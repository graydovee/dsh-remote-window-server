{
  "name": "dsh-remote-workspace-server",
  "version": "0.1.0-alpha.3",
  "description": "DeepSeek Harness server plugin for dsh-remote-workspace v2: expose a per-client profile DSH to its SSH client through the P1 API, lease, managed agents, native session stream and registry guard.",
  "type": "module",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.3"
  },
  "packageManager": "pnpm@10.34.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/graydovee/dsh-remote-workspace-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.plugin.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown && tsdown --config tsdown.plugin.config.mjs",
    "pack:server-plugin": "node scripts/pack-server-plugin.mjs",
    "build:runtime": "node scripts/build-runtime-artifact.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "remote-workspace",
    "ssh",
    "server-package"
  ]
}
